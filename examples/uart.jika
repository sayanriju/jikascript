// UART serial output on the CH32V003 USART1 default pins (TX=PD5, RX=PD6).
const serial = uart("PD5", "PD6", 115200);

serial.println("jikascript uart online");

task("uart_poll", 200, () => {
    if (serial.available()) {
        let ch = serial.read();
        serial.writeByte(ch);
    }
});

scheduler.start();
